        <PAGEOBJECT XPOS="237.178343949045" YPOS="148.955414012739" OwnPage="0" ItemID="1971303809" PTYPE="4" WIDTH="340.822656050955" HEIGHT="27.1464968152866" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L340.823 0 L340.823 27.1465 L0 27.1465 L0 0 Z" copath="M0 0 L340.823 0 L340.823 27.1465 L0 27.1465 L0 0 Z" gXpos="237.178343949045" gYpos="148.955414012739" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
